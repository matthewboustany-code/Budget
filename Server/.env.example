# Budget server configuration. Copy to `.env` (git-ignored) and fill in.
# Never commit real secrets.

# --- Database ---
# Path to the SQLite file. In Docker this points at a mounted volume.
BUDGET_DB_PATH=./budget.sqlite

# --- Auth (Sign in with Apple) ---
# The app's bundle identifier; the audience the Apple identity token must match.
# A native iOS sign-in needs nothing else from Apple: the identity token is
# verified against Apple's public JWKS. (No Services ID or .p8 key — those are
# for web/Android sign-in and server-to-server token revocation.)
APPLE_BUNDLE_ID=com.mbandhb.budget
# Secret used to sign our own session (bearer) JWTs. Generate a long random
# string, e.g. `openssl rand -hex 32`.
SESSION_JWT_SECRET=change-me-to-a-long-random-string

# --- Plaid ---
# From the Plaid dashboard. Start in sandbox; production needs Plaid approval.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Comma-separated Plaid products, e.g. transactions.
PLAID_PRODUCTS=transactions
# Public base URL Plaid can reach for webhooks (use an ngrok URL in dev).
PLAID_WEBHOOK_URL=

# Key used to encrypt Plaid access tokens at rest (32 bytes hex).
PLAID_TOKEN_ENC_KEY=change-me-to-32-bytes-hex

# --- Push notifications (bill reminders) ---
# OPTIONAL. Leave blank and the bill-reminder command just logs, exactly as it
# did before push existed — a missing or expired key never blocks startup.
# All four must be set together for push to turn on.
# Key id of the APNs .p8 key (Apple Developer -> Keys).
APNS_KEY_ID=
# Your Apple team id.
APNS_TEAM_ID=
# The .p8 file's *contents*, not a path. Newlines may be written as \n so the
# key fits on one line in compose.
APNS_KEY_P8=
# APNs topic = the app's bundle id. Defaults to APPLE_BUNDLE_ID if unset.
APNS_TOPIC=
# One .p8 key serves BOTH environments (unlike the legacy .p12 certificates),
# so only one key is ever needed. The server registers a sandbox and a
# production connection from it and routes each device token to the host that
# minted it. APNS_ENV only picks the default for tokens with no recorded
# environment: `sandbox` for development-signed builds, `production` for
# TestFlight/App Store.
APNS_ENV=sandbox

# --- Deployment (docker compose; see DEPLOY.md) ---
# In production the server REFUSES to boot if SESSION_JWT_SECRET or
# PLAID_TOKEN_ENC_KEY are missing/placeholders, or if AUTH_DEV_MODE is set.

# DNS name pointing at this host. Caddy obtains the TLS certificate for it.
BUDGET_DOMAIN=budget.example.com
# Host directory for the SQLite database + backups (mounted at /data).
BUDGET_DATA_DIR=./data
# Log level for the container. Defaults to info so the nightly sync/bill-reminder
# runs leave a readable trail; set to `notice` for a quieter production log.
BUDGET_LOG_LEVEL=info
# Optional: POSTed a plain-text message when the nightly sync fails.
BUDGET_FAIL_WEBHOOK=
# How long scripts/backup-db.sh keeps nightly backups (days).
BUDGET_BACKUP_KEEP_DAYS=30
