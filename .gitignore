# Secrets — never commit API keys (Plaid, Apple) or session signing keys.
.env
.env.*
!Server/.env.example

# SQLite databases and WAL sidecars
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Swift / SwiftPM
.build/
.swiftpm/
Package.resolved
# …but keep the app's pinned resolution (pins LinkKit for reproducible builds)
!Budget.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
# …and the server's, which Server/Dockerfile COPYs — without it committed, the
# image cannot be built from a fresh clone, only from a working tree that
# happens to have resolved already.
!Server/Package.resolved

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
build/

# macOS
.DS_Store

# Server runtime
Server/logs/

# Rendered legal pages — build/ output from scripts/build-legal-pages.py.
# The markdown in docs/legal/ is the source of truth.
build/
